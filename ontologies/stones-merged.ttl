stones:Tool
	a owl:Class ;
	rdfs:subClassOf
		stones:StixDomainObject ,
		[
			a owl:Restriction ;
			owl:onProperty stones:name ;
			owl:minCardinality "1"^^xsd:nonNegativeInteger ;
		] ,
		[
			a owl:Restriction ;
			owl:onProperty stones:toolTypes ;
			owl:minCardinality "1"^^xsd:nonNegativeInteger ;
