stones:WindowsRegistryValue
	a owl:Class ;
	rdfs:subClassOf
		stones:StixSubType ,
		[
			a owl:Restriction ;
			owl:onProperty stones:name ;
			owl:minCardinality "1"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:isDefinedBy <https://cyberterrain.org/ns/stones#> ;
	skos:definition "A single value entry within a Windows Registry key, comprising a name, a data string, and a registry data type." ;
	skos:prefLabel "Windows Registry Value"@en ;
	.

stones:WindowsServiceStartTypeEnumeration
	a owl:Class ;
	rdfs:subClassOf stones:Enumeration ;
	owl:equivalentClass [
		owl:oneOf (
			stonex:_SERVICE_AUTO_START
			stonex:_SERVICE_BOOT_START
			stonex:_SERVICE_DEMAND_START
			stonex:_SERVICE_DISABLED
			stonex:_SERVICE_SYSTEM_ALERT
		) ;
	] ;
	.

stones:WindowsServiceStatusEnumeration
	a owl:Class ;
	rdfs:subClassOf stones:Enumeration ;
	owl:equivalentClass [
		owl:oneOf (
			stonex:_SERVICE_CONTINUE_PENDING
			stonex:_SERVICE_PAUSE_PENDING
			stonex:_SERVICE_PAUSED
			stonex:_SERVICE_RUNNING
			stonex:_SERVICE_START_PENDING
			stonex:_SERVICE_STOP_PENDING
			stonex:_SERVICE_STOPPED
		) ;
	] ;
	.

stones:WindowsServiceTypeEnumeration
	a owl:Class ;
	rdfs:subClassOf stones:Enumeration ;
	owl:equivalentClass [
		owl:oneOf (
			stonex:_SERVICE_FILE_SYSTEM_DRIVER
			stonex:_SERVICE_KERNEL_DRIVER
			stonex:_SERVICE_WIN32_OWN_PROCESS
			stonex:_SERVICE_WIN32_SHARE_PROCESS
		) ;
	] ;
	.

stones:X509CertificateObject
	a owl:Class ;
	rdfs:subClassOf stones:StixCyberobservableObject ;
	rdfs:isDefinedBy <https://cyberterrain.org/ns/stones#> ;
	owl:equivalentClass [
		a owl:Class ;
		owl:intersectionOf (
			stones:StixObject
			[
				a owl:Restriction ;
				owl:onProperty stones:stixType ;
				owl:hasValue "x509-certificate" ;
			]
		) ;
	] ;
	skos:definition "Represents an X.509 digital certificate, capturing its subject, issuer, validity window, public key details, and optional v3 extensions." ;
	skos:prefLabel "X.509 Certificate Object"@en ;
	.

stones:X509V3Extensions
