	rdfs:isDefinedBy <https://cyberterrain.org/ns/stones#> ;
	owl:equivalentClass [
		a owl:Class ;
		owl:intersectionOf (
			stones:StixObject
			[
				a owl:Restriction ;
				owl:onProperty stones:stixType ;
				owl:hasValue "note" ;
			]
		) ;
	] ;
