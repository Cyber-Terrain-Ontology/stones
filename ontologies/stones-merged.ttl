stones:EncryptionAlgorithmEnumeration
	a owl:Class ;
	rdfs:subClassOf stones:Enumeration ;
	owl:equivalentClass [
		owl:oneOf (
			stonex:_AES-256-GCM
			stonex:_ChaCha20-Poly1305
			stonex:_mime-type-indicated
		) ;
	] ;
	.

stones:Enumeration
	a owl:Class ;
	rdfs:subClassOf stones:Vocabulary ;
	.

stones:ExtensionDefinitionObject
	a owl:Class ;
	rdfs:subClassOf stones:StixMetaObject ;
	rdfs:isDefinedBy <https://cyberterrain.org/ns/stones#> ;
	owl:equivalentClass [
		a owl:Class ;
		owl:intersectionOf (
			stones:StixObject
			[
				a owl:Restriction ;
				owl:onProperty stones:stixType ;
				owl:hasValue "extension-definition" ;
			]
		) ;
	] ;
	skos:definition "Defines a schema extension to STIX 2.1. Allows producers to add new properties or new object types in a structured, interoperable way." ;
	skos:prefLabel "Extension Definition Object"@en ;
	.

stones:ExtensionTypesEnumeration
	a owl:Class ;
	rdfs:subClassOf stones:Enumeration ;
	owl:equivalentClass [
		owl:oneOf (
			stonex:_new-sco
			stonex:_new-sdo
			stonex:_new-sro
			stonex:_property-extension
			stonex:_toplevel-property-extension
		) ;
	] ;
