@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix stones: <https://cyberterrain.org/ns/stones#> .
@base <https://cyberterrain.org/ns/stones#> .

###  https://cyberterrain.org/ns/stones-classification#
<https://cyberterrain.org/ns/stones-classification#> rdf:type owl:Ontology ;
    owl:versionIRI <https://cyberterrain.org/ns/stones-classification/0.1.1> ;
    owl:imports <https://cyberterrain.org/ns/stones-core> ;
    rdfs:label "STONES Classifications"@en .

#################################################################
#    Abstract Structural Classes
#################################################################

stones:StixObject 
    rdfs:subClassOf
        [ a owl:Restriction ; owl:onProperty stones:stixId ;       owl:minCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ; owl:onProperty stones:stixType ;     owl:minCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ; owl:onProperty stones:specVersion ;  owl:minCardinality "1"^^xsd:nonNegativeInteger ] .

stones:StixCoreObject 
    rdfs:subClassOf stones:StixObject ,
        [ a owl:Restriction ; owl:onProperty stones:created ;  owl:minCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ; owl:onProperty stones:modified ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] .

stones:StixDomainObject rdfs:subClassOf stones:StixCoreObject .
stones:StixCyberobservableObject rdfs:subClassOf stones:StixCoreObject .
stones:StixRelationshipObject rdfs:subClassOf stones:StixCoreObject .
stones:StixMetaObject rdfs:subClassOf stones:StixObject .
stones:StixSubType rdfs:subClassOf owl:Thing ;
    owl:disjointWith stones:StixObject .

stones:StixBundle 
    rdfs:subClassOf stones:StixObject ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( stones:StixObject [ a owl:Restriction ; owl:onProperty stones:stixType ; owl:hasValue "bundle"^^xsd:string ] ) ] .

#################################################################
#    STIX Domain Objects (SDOs)
#################################################################

stones:AttackPattern 
    rdfs:subClassOf stones:StixDomainObject ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( stones:StixObject [ a owl:Restriction ; owl:onProperty stones:stixType ; owl:hasValue "attack-pattern"^^xsd:string ] ) ] .

