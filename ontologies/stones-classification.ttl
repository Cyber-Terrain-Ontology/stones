    rdfs:subClassOf stones:StixDomainObject ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( stones:StixObject [ a owl:Restriction ; owl:onProperty stones:stixType ; owl:hasValue "campaign"^^xsd:string ] ) ] .

