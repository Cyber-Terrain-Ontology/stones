stones:Relationship 
    rdfs:subClassOf stones:StixRelationshipObject ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( stones:StixObject [ a owl:Restriction ; owl:onProperty stones:stixType ; owl:hasValue "relationship"^^xsd:string ] ) ] .

stones:Sighting 
    rdfs:subClassOf stones:StixRelationshipObject ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( stones:StixObject [ a owl:Restriction ; owl:onProperty stones:stixType ; owl:hasValue "sighting"^^xsd:string ] ) ] .

