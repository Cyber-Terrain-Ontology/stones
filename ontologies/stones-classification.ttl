    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( stones:StixObject [ a owl:Restriction ; owl:onProperty stones:stixType ; owl:hasValue "intrusion-set"^^xsd:string ] ) ] .

stones:Location 
    rdfs:subClassOf stones:StixDomainObject ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( stones:StixObject [ a owl:Restriction ; owl:onProperty stones:stixType ; owl:hasValue "location"^^xsd:string ] ) ] .

